// Pong sketch – Purplecode 1.8 hierarchical GUI
// Cleaner API, same fast software-blitter feel.

fn main() {
    Data.ShellPrint("Pong sketch 1.8")

    GUI.Window.CreateSized(800, 500, "Purplecode Pong")
    GUI.Clear(0xFF0A0A12)

    let paddle_y: int = 200
    let ball_x: int = 400
    let ball_y: int = 250
    let ball_dx: int = 5
    let ball_dy: int = 4
    let frames: int = 0
    let running: int = 1
    let score: int = 0

    while running == 1 {
        let k: int = GUI.PollKey()
        if k == 1002 {          // up
            paddle_y = paddle_y - 12
        }
        if k == 1003 {          // down
            paddle_y = paddle_y + 12
        }
        if k == 27 {
            running = 0
        }
        if k == -1 {
            running = 0
        }

        // keep paddle on screen
        if paddle_y < 10 {
            paddle_y = 10
        }
        if paddle_y > 400 {
            paddle_y = 400
        }

        ball_x = ball_x + ball_dx
        ball_y = ball_y + ball_dy

        if ball_y < 8 {
            ball_dy = 0 - ball_dy
            ball_y = 8
        }
        if ball_y > 480 {
            ball_dy = 0 - ball_dy
            ball_y = 480
        }
        if ball_x > 780 {
            ball_dx = 0 - ball_dx
            ball_x = 780
        }

        // paddle collision (left side)
        if ball_x < 40 {
            if ball_y > paddle_y {
                if ball_y < paddle_y + 90 {
                    ball_dx = 0 - ball_dx
                    ball_x = 40
                    score = score + 1
                }
            }
        }
        if ball_x < 0 {
            // miss – reset
            ball_x = 400
            ball_y = 250
            ball_dx = 5
            ball_dy = 4
        }

        GUI.Clear(0xFF0A0A12)
        GUI.Draw.Rect(20, paddle_y, 14, 90, 0xFFFFFF)
        GUI.Draw.Rect(ball_x, ball_y, 14, 14, 0xFFFF00)
        GUI.DrawLine(400, 10, 400, 490, 0x333355)   // center line
        GUI.DrawText(20, 12, "Arrow keys = paddle   Esc = quit", 0x8888AA)
        GUI.Present()
        GUI.Pump(14)

        frames = frames + 1
        if frames > 2400 {
            running = 0
        }
    }

    Data.ShellPrint("pong done")
    return 0
}
